@model IEnumerable<DartmentDto>
@{
    ViewData["Title"] = "Index";
}

<h1>Departments</h1>

<br />
<br />
<a asp-controller="Department" asp-action="Create" class="btn btn-primary">Create New Department</a>
<br />


@* <div class="alert alert-info mb-3">  *@
@*     <h5>@ViewData["Message"]</h5> *@
@*  </div> *@

@* <div class="alert alert-info mb-3"> *@
@*     <h5>@ViewBag.Message</h5> *@
@* </div> *@


@if (!string.IsNullOrEmpty(TempData["Message"] as string))
{
    <div class="alert alert-success mb-3">
        <h5>@TempData["Message"]</h5>
    </div>




}

@if (Model.Count() > 0)
{
    <table class="table table-striped table-hover mt-4">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(D => D.Code)</th>
                <th>@Html.DisplayNameFor(D => D.Name)</th>
                <th>@Html.DisplayNameFor(D => D.CreationDate)</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody class="text-center">
            @foreach (var dept in Model)
            {
                <tr>
                    <td>@dept.Code</td>
                    <td>@dept.Name</td>
                    <td>@dept.CreationDate.ToShortDateString()</td>

                    <td>
                        <a asp-action="Details" asp-route-id="@dept.Id" class="btn btn-warning"><i class="bi bi-eye"></i> Details</a>
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@dept.Id" class="btn btn-success"><i class="bi bi-pencil-square"></i> Update</a>
                    </td>
                    <td>
                        <!-- Button trigger modal -->
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@dept.Id">
                            <i class="bi bi-trash"></i> Delete
                        </button>

                        <!-- Modal -->
                        <div class="modal fade" id="deleteModal-@dept.Id" tabindex="-1" aria-labelledby="modalLabel-@dept.Id" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="modalLabel-@dept.Id">Delete Department</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        Are you sure you want to delete <strong>@dept.Name</strong>?
                                    </div>
                                    <div class="modal-footer">
                                        <form asp-action="Delete" asp-route-DeptId="@dept.Id" method="post">
                                            <button type="submit" class="btn btn-danger">Delete</button>
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{


    <div class="alert alert-info mt-3">
        <h3>  No Department Found </h3>
    </div>

}