@using IKEA_Business_Logic_Layer.Services.DepartmentServices
@model EmployeeViewModel
@inject IDepartementServices departmentService
@{
    ViewData["Title"] = "Create Employee";
    var Departments = new SelectList(await departmentService.GetAllDebartments(), nameof(DartmentDto.Id), nameof(DartmentDto.Name));
}
<div class="row justify-content-center align-content-center flex-column">
    <h1 class="col-6 my-4">Create New Employee</h1>
    <form asp-action="Create" method="post" class="row col-6" enctype="multipart/form-data">

        <partial name="partialss/EmployeeCreateEditPartialView" model="@Model" />

        <div class="form-group col-6">
            <label asp-for="DepartmentId"></label>
            <select asp-for="DepartmentId" asp-items="@Departments" class="form-control">
                <option value="">Choose...</option>      
            </select>
        </div>

        <div class="mt-4">
            <input type="submit" value="Create" class="btn btn-primary" /> |
            <a asp-controller="Department" asp-action="Index" class="btn btn-secondary">Back To Home Page</a>
        </div>

        @section ValidateScripts {
            <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
            <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
        }

    </form>
</div>
