@model EmployeeViewModel
@inject IDepartementServices departmentService

@{
    ViewData["Title"] = "Edit";
    var Departments = new SelectList(await departmentService.GetAllDebartments(), nameof(DartmentDto.Id), nameof(DartmentDto.Name));

}

<div class="row justify-content-center align-content-center flex-column">

    <form asp-action="Edit" method="post" class="row col-6" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />


        <partial name="partialss/EmployeeCreateEditPartialView" model="@Model" />

        <div class="form-group col-6">
            <label asp-for="DepartmentId"></label>
            <select asp-for="DepartmentId" asp-items="@Departments" class="form-control">
                <option value="@null">Choose...</option>
            </select>
        </div>



        <div class="mt-4">
            <input type="submit" value="Update" class="btn btn-success" /> ||
            <a asp-action="Index" class="btn btn-secondary">Back To List</a>
        </div>





@section ValidateScripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}

    </form>