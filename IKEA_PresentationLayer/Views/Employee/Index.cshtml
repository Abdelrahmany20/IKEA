@model IEnumerable<EmployeeDto>
@{
    ViewData["Title"] = "Employees";
}

<h1>Employees</h1>

<br />
<br />
<a asp-controller="Employee" asp-action="Create" class="btn btn-primary">Create New Employee</a>
<br />

<form asp-action="Index" method="get" class="mt-3 row justify-content-center align-items-center">
    <div class="row col-8 offset-1">
        <div class="col-8">
            <input type="text" name="search" class="form-control" placeholder="Search By Name. .. " />
        </div>
        <div class="col-4">
            <input type="submit" value="Search" class="btn btn-success"
        </div>
    </div>

</form>



@if (Model.Count() > 0)
{
    <table class="table table-striped table-hover mt-4">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(E => E.Name)</th>
                <th>@Html.DisplayNameFor(D => D.Email)</th>
                <th>@Html.DisplayNameFor(D => D.EmployeeType)</th>
                <th>@Html.DisplayNameFor(E => E.Department)</th>
                <th>@Html.DisplayNameFor(D => D.Age)</th>
                <th>@Html.DisplayNameFor(D => D.Salary)</th>
                <th>@Html.DisplayNameFor(D => D.IsActive)</th>
                <th>@Html.DisplayNameFor(D => D.Gender)</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody class="text-center">
            @foreach (var emp in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(e => emp.Name)</td>
                    <td>@Html.DisplayFor(e => emp.Email)</td>
                    <td>@Html.DisplayFor(e => emp.EmployeeType)</td>
                    <td>@Html.DisplayFor(e => emp.Department)</td>
                    <td>@Html.DisplayFor(e => emp.Age)</td>
                    <td>@Html.DisplayFor(e => emp.Salary)</td>
                    <td>@Html.DisplayFor(e => emp.IsActive)</td>
                    <td>@Html.DisplayFor(e => emp.Gender)</td>


                    <td>
                        <a href="@Url.Action("Details", "Employee", new { id = emp.Id })" class="btn btn-info">Details</a>
                    </td>
                    <td>
                        <a href="@Url.Action("Edit", "Employee", new { id = emp.Id })" class="btn btn-warning">Update</a>
                    </td>
                    <td>
                        <!-- Button to trigger modal -->
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteEmployeeModal"
                                data-id="@emp.Id" data-name="@emp.Name">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info mt-3">
        <h3>  No Employees Found </h3>
    </div>
}

<!-- Modal -->
<div class="modal fade" id="deleteEmployeeModal" tabindex="-1" aria-labelledby="deleteEmployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteEmployeeModalLabel">Delete Employee</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <h4>Are You Sure You Want To Delete Employee <span id="employeeName"></span>?</h4>
            </div>
            <div class="modal-footer">
                <form asp-action="Delete" method="post">
                    <input type="hidden" id="empId" name="EmpId" />
                    <div class="mt-4">
                        <input type="submit" value="Delete" class="btn btn-danger" />
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Handle dynamic modal content
    var deleteModal = document.getElementById('deleteEmployeeModal');
    deleteModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        var empId = button.getAttribute('data-id');
        var empName = button.getAttribute('data-name');

        var modalTitle = deleteModal.querySelector('.modal-title');
        var employeeName = deleteModal.querySelector('#employeeName');
        var empIdField = deleteModal.querySelector('#empId');

        employeeName.textContent = empName;
        empIdField.value = empId;
    });
</script>





















