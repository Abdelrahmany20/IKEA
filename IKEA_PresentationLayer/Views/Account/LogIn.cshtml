@model LogInViewModel
@{
    ViewData["Title"] = "LogIn";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}


<div class="main-agileinfo">
	<div class="agileits-top">
		<form asp-action="Login" method="post">
			<input class="text" style="margin-bottom:10px" asp-for="Email" placeholder="Email" required="">
            <input class="text" style="margin-bottom:10px" asp-for="Password" placeholder="Password" required="">




			<div class="wthree-text">
				<label class="anim">
					<input type="checkbox" class="checkbox" asp-for="RememberMe" required="">
					<span>Remmember Me</span>
				</label>
				<div class="clear"> </div>
			</div>
			<input type="submit" value="Log In">
		</form>
		<p>Don't have an Account? <a href="/Account/SignUp"> Register Now!</a></p>
	</div>
</div>

